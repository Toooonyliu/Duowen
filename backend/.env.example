DUOWEN_DATA_DIR=/data/duowen
DUOWEN_ALLOWED_ORIGINS=https://toooonyliu.github.io
DUOWEN_WHISPER_MODEL=base
DUOWEN_DEVICE=cpu
DUOWEN_COMPUTE_TYPE=int8
DUOWEN_BATCH_SIZE=1
DUOWEN_ALIGN=1
DUOWEN_ALIGN_LANGUAGES=en,zh
DUOWEN_DIARIZE=0
DUOWEN_MAX_UPLOAD_MB=100
DUOWEN_MAX_DURATION_SECONDS=1800
DUOWEN_MAX_PENDING_JOBS=4
DUOWEN_UPLOADS_PER_IP_HOUR=5
DUOWEN_JOB_TIMEOUT_SECONDS=1800
DUOWEN_RETENTION_SECONDS=86400
DUOWEN_MAX_STORAGE_MB=2048
# HF_TOKEN is a runtime server secret, never a frontend/VITE variable.
# Diarization requires the model's Hugging Face agreement and a read token.
